---
import Layout from '../layouts/Layout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { openSource } from '../data/content';
---

<Layout title="Resume | Dan Gilles" description="Dan Gilles's resume. AI engineering, agent infrastructure, open-source contributions, research, and education.">
  <main id="main" class="container resume" tabindex="-1">
    <header class="resume-heading">
      <div>
        <p class="eyebrow">Resume</p>
        <h1>Dan Gilles</h1>
        <p class="resume-role">AI engineer · Agent infrastructure · Developer tools</p>
      </div>
      <button type="button" id="print-resume" class="button secondary" hidden>Print / save PDF <span aria-hidden="true">↗</span></button>
      <ul class="resume-contact" aria-label="Contact and profiles">
        <li><a href="mailto:dangilles@gmail.com">dangilles@gmail.com</a></li>
        <li><a href="https://github.com/Audacity88">github.com/Audacity88</a></li>
        <li><a href="https://www.linkedin.com/in/dfgilles">linkedin.com/in/dfgilles</a></li>
      </ul>
    </header>

    <section class="resume-summary" aria-labelledby="summary-title">
      <h2 id="summary-title" class="sr-only">Summary</h2>
      <p>AI-native full-stack engineer who builds directly with the people who use the software. I build agent infrastructure, including Eyrie and Commander, and contribute as a code owner to ZeroClaw. Coding agents write much of my code. I specify the problem, review every change, test it live, and decide what ships.</p>
      <a class="text-link" href={openSource.mergedList}>{openSource.count.label}</a>
    </section>

    <section class="resume-section" aria-labelledby="resume-experience-title">
      <h2 id="resume-experience-title">Experience</h2>
      <ExperienceTimeline />
    </section>

    <div class="resume-details">
      <section class="resume-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Skills</h2>
        <dl class="resume-skills">
          <div><dt>Languages and frameworks</dt><dd>TypeScript, React, Vite, Node.js, Go, Rust (Tokio), Python, SQL</dd></div>
          <div><dt>Data and real-time systems</dt><dd>PostgreSQL, SQLite, Socket.io, SSE</dd></div>
          <div><dt>AI engineering</dt><dd>LLM provider integration, tool calling, streaming fallback, prompt caching and cost analysis, evals</dd></div>
          <div><dt>Development tools</dt><dd>Git, Claude Code, Codex, Cursor</dd></div>
        </dl>
      </section>

      <div>
        <section class="resume-section" aria-labelledby="education-title">
          <h2 id="education-title">Education</h2>
          <dl class="resume-education">
            <div><dt>University of Chicago</dt><dd>M.A., Computational Social Science (NLP/ML) · 2024</dd></div>
            <div><dt>St. John's College, Santa Fe</dt><dd>M.A., Eastern Classics · 2022</dd></div>
            <div><dt>St. John's College</dt><dd>B.A., Liberal Arts (Great Books) · 2013</dd></div>
          </dl>
        </section>

        <section class="resume-section" aria-labelledby="languages-title">
          <h2 id="languages-title">Languages</h2>
          <p>English, native. Mandarin Chinese, professionally fluent.</p>
        </section>
      </div>
    </div>
  </main>
  <script>
    const printButton = document.querySelector<HTMLButtonElement>('#print-resume');
    if (printButton) {
      printButton.hidden = false;
      printButton.addEventListener('click', () => window.print());
    }
  </script>
</Layout>

<style>
  .resume { max-width: 1000px; padding-block: 4rem 5rem; }
  .resume-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; }
  .resume-heading .eyebrow { margin-bottom: 1rem; }
  .resume h1 { font-size: clamp(3rem, 6vw, 4.5rem); }
  .resume-role { color: var(--accent-text); margin-top: 1rem; }
  .resume-contact { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: .25rem 1.75rem; list-style: none; padding: 0; font-size: .85rem; }
  .resume-contact a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .resume-summary { padding-block: 2rem; max-width: 78ch; }
  .resume-summary p { color: var(--muted); }
  .resume-summary .text-link { margin-top: .5rem; }
  .resume-section { border-top: 1px solid var(--line); padding-top: 1.75rem; margin-top: 1.75rem; }
  .resume-section h2 { font-size: 1.65rem; letter-spacing: -.025em; margin-bottom: 1.5rem; }
  .resume-section :global(.timeline > li:first-child) { border-top: 0; padding-top: 0; }
  .resume-section :global(.timeline > li:last-child) { padding-bottom: 0; }
  .resume-skills, .resume-education { display: grid; gap: 1.25rem; }
  .resume dt { font-weight: 550; }
  .resume dd, .resume-section > p { color: var(--muted); font-size: .95rem; }
  @media (max-width: 760px) {
    .resume { padding-block: 2.5rem 3rem; }
    .resume-contact { flex-direction: column; gap: 0; }
  }
  @media print {
    .resume { max-width: none; padding: 0; font-family: Arial, Helvetica, sans-serif; }
    .resume-heading { display: block; }
    .resume-heading .eyebrow, #print-resume { display: none; }
    .resume h1 { font-size: 25pt; }
    .resume-role { margin-top: 4pt; font-size: 10pt; }
    .resume-contact { display: flex; flex-direction: row; gap: 0 14pt; margin-top: 5pt; font-size: 8pt; }
    .resume-contact a { min-height: 0; }
    .resume-summary { padding: 10pt 0 0; max-width: none; }
    .resume-summary .text-link { margin-top: 4pt; }
    .resume-section { padding-top: 6pt; margin-top: 7pt; border-color: #aaa; }
    .resume-section h2 { font-size: 13pt; margin-bottom: 5pt; }
    .resume-section :global(.timeline > li) { display: block; padding-block: 4pt; }
    .resume-section :global(.timeline-period) { float: right; margin-left: 12pt; }
    .resume-section :global(.timeline-content > p:not(.organization)), .resume-section :global(.timeline-content ul) { margin-top: 3pt; }
    .resume-details { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20pt; break-inside: avoid; }
    .resume-skills { gap: 5pt; }
    .resume-skills > div { break-inside: avoid; }
    .resume-education { gap: 5pt; }
    .resume-education > div { break-inside: avoid; }
    .resume dd, .resume-section > p { font-size: 8.5pt; }
  }
</style>

<style is:global>
  @media print {
    body:has(.resume) .site-header { display: none; }
    .resume li::marker { color: #111 !important; }
  }
</style>
