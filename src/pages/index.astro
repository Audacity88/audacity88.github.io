---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import TerminalFetch from '../components/TerminalFetch.astro';
import SoftEnter from '../components/SoftEnter.astro';
import RepoPulse from '../components/RepoPulse.astro';
import { projects, openSource } from '../data/content';

const base = import.meta.env.BASE_URL;
---

<Layout>
  <SoftEnter />
  <main id="main" class="container" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-intro">
        <p class="eyebrow"><span class="accent-mark" aria-hidden="true"></span>AI engineer / Dan Gilles</p>
        <h1 id="hero-title">I build AI agents and <span>developer tools.</span></h1>
        <p class="hero-pitch">From an ambiguous brief to a working pilot.</p>
        <p class="hero-description">I work directly with the people who use the software. I also build agent infrastructure and contribute as a code owner to ZeroClaw, an open-source Rust agent runtime.</p>
        <TerminalFetch />
        <div class="hero-actions">
          <a class="button primary" href="mailto:dan@dangilles.dev">Get in touch <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="https://github.com/Audacity88" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={`${base}resume/`} target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-note" aria-label="Current work">
        <div class="signal-art" aria-hidden="true">
          <svg viewBox="0 0 280 230" fill="none" focusable="false">
            <path class="signal-grid" d="M0 46H280M0 92H280M0 138H280M0 184H280M46 0V230M92 0V230M138 0V230M184 0V230M230 0V230" />
            <g class="signal-orbits"><ellipse cx="140" cy="115" rx="110" ry="42" transform="rotate(-35 140 115)" /><ellipse cx="140" cy="115" rx="110" ry="42" transform="rotate(35 140 115)" /><ellipse cx="140" cy="115" rx="42" ry="100" /></g>
            <circle class="signal-center" cx="140" cy="115" r="10" /><g class="signal-static"><circle class="signal-node" cx="221" cy="61" r="5" /><circle class="signal-node" cx="58" cy="62" r="5" /><circle class="signal-node" cx="140" cy="215" r="5" /></g>
            <g class="signal-electrons" id="signal-electrons">
              <g transform="rotate(-35 140 115)"><g class="electron-x e1"><g class="electron-y e1"><circle class="signal-node" cx="140" cy="115" r="5" /></g></g></g>
              <g transform="rotate(35 140 115)"><g class="electron-x e2"><g class="electron-y e2"><circle class="signal-node" cx="140" cy="115" r="5" /></g></g></g>
              <g><g class="electron-x e3"><g class="electron-y e3"><circle class="signal-node" cx="140" cy="115" r="5" /></g></g></g>
            </g>
          </svg>
        </div>
        <p class="eyebrow">What I work on</p>
        <p>Agent infrastructure.<br />Built with the people<br />who use it.</p>
        <div class="focus-item">
          <span>Building</span>
          <div class="focus-link-group">
            <a href="https://github.com/EyrieCommander/eyrie">Eyrie <span aria-hidden="true">↗</span></a>
            <RepoPulse repoId="eyrie" />
          </div>
        </div>
        <div class="focus-item">
          <span>Contributing</span>
          <div class="focus-link-group">
            <a href={openSource.url}>ZeroClaw <span aria-hidden="true">↗</span></a>
            <RepoPulse repoId="zeroclaw" />
          </div>
        </div>
      </aside>
      <a class="hero-scroll" href="#consulting">Consulting services <span aria-hidden="true">↓</span></a>
    </section>

    <section id="consulting" class="consulting-strip" aria-labelledby="consulting-title">
      <div class="consulting-content">
        <h2 id="consulting-title">I set up AI agents your team can trust.</h2>
        <p>For founders, consultants, and small teams: concrete agent setup with clear handover documentation you can run and modify yourself.</p>
        <a class="consulting-cta" href={`${base}offers/`}>Explore consulting <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Selected work</p><h2 id="projects-title">Things I've built <br />and contributed to.</h2></div>
        <p class="section-intro">Agent tooling, full-stack applications, and iOS experiments. Each project states what was checked and what remains unverified.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <section id="open-source" class="section" aria-labelledby="opensource-title">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Open source</p><h2 id="opensource-title">Making agents <br />more reliable.</h2></div>
        <p class="section-intro">At ZeroClaw, I own code across runtime, tools, gateway, configuration, memory, and cost. These upstream pull requests are merged.</p>
      </div>
      <div class="contribution-layout">
        <aside class="contribution-note">
          <h3>Steering, recovery, and cost.</h3>
          <p>My work includes delivering steering messages during a running turn, recovering sessions, and making agent costs visible.</p>
          <div class="cache-result">
            <p class="eyebrow">Prompt-cache hit rate</p>
            <p class="cache-values"><span class="sr-only">From </span>81.8% <span aria-hidden="true">↗</span><span class="sr-only"> to </span> 93.1%</p>
            <p>Controlled A/B on the same 30 prompts. About 51% lower effective input cost.</p>
          </div>
          {openSource.count.display && <a class="text-link" href={openSource.mergedList}>{openSource.count.label} <span aria-hidden="true">↗</span></a>}
          <br /><a class="text-link" href="https://github.com/community/maintainers">Member, GitHub Maintainer Community <span aria-hidden="true">↗</span></a>
        </aside>
        <ul class="pr-list" aria-label="Selected merged ZeroClaw pull requests">
          {openSource.pullRequests.map((pr) => (
            <li>
              <a class="pr-card" href={pr.url}>
                <span class="pr-meta">{pr.area}<span>#{pr.number} · Merged</span></span>
                <h3>{pr.title}<span aria-hidden="true"> ↗</span></h3>
                {pr.summary && <p class="pr-summary">{pr.summary}</p>}
                <time datetime={pr.mergedAt}>{new Date(`${pr.mergedAt}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="experience" class="section" aria-labelledby="experience-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Experience</p><h2 id="experience-title">Engineering, research, <br />and teaching.</h2></div></div>
      <ExperienceTimeline />
    </section>

    <section id="how-i-work" class="section two-column-section" aria-labelledby="workflow-title">
      <div><p class="eyebrow">04 / Workflow</p><h2 id="workflow-title">How I work.</h2></div>
      <div class="section-copy">
        <p>Coding agents write much of my code. I specify the problem, review every change, test it live, and decide what ships.</p>
      </div>
    </section>

    <section id="about" class="section two-column-section" aria-labelledby="about-title">
      <div><p class="eyebrow">05 / About</p><h2 id="about-title">Background <br />and education.</h2></div>
      <div class="section-copy">
        <p>I spent about a decade living and teaching in Beijing before studying computational social science at the University of Chicago. English is my native language, and I'm professionally fluent in Mandarin Chinese.</p>
        <dl class="education-list">
          <div><dt>University of Chicago</dt><dd>M.A., Computational Social Science, NLP/ML · 2024</dd></div>
          <div><dt>St. John's College</dt><dd>M.A., Eastern Classics · 2022<br />B.A., Liberal Arts, Great Books · 2013</dd></div>
        </dl>
      </div>
    </section>

    <section id="contact" class="section contact-section" aria-labelledby="contact-title">
      <p class="eyebrow">06 / Contact</p>
      <h2 id="contact-title">Have a problem <br />worth working on?</h2>
      <p>Let's talk about AI agents, developer tools, or building software with your team.</p>
      <a class="contact-email" href="mailto:dan@dangilles.dev">dan@dangilles.dev <span aria-hidden="true">↗</span></a>
      <ul class="social-links" aria-label="Find Dan online">
        <li><a href="https://github.com/Audacity88" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://www.linkedin.com/in/dfgilles">LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://x.com/jialaowai">X <span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </main>
</Layout>

<script>
  import { onShellStateChange } from '../lib/portfolio-shell';
  
  function init() {
    const signalElectrons = document.getElementById('signal-electrons');
    const signalArt = document.querySelector('.signal-art');
    
    onShellStateChange((changes) => {
      if (changes.motionPaused !== undefined) {
        if (changes.motionPaused) {
          document.documentElement.style.setProperty('--motion-paused', 'paused');
          signalElectrons?.classList.add('motion-paused');
        } else {
          document.documentElement.style.setProperty('--motion-paused', 'running');
          signalElectrons?.classList.remove('motion-paused');
        }
      }
      
      if (changes.palette !== undefined && signalArt) {
        signalArt.classList.add('accent-flash');
        setTimeout(() => {
          signalArt.classList.remove('accent-flash');
        }, 400);
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
