---
import { existsSync, statSync } from 'node:fs';
import { resolve } from 'node:path';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, experience, openSource } from '../data/content';

// TODO: Add an approved resume as public/resume.pdf. The link stays hidden until it exists.
const resumePath = resolve('public/resume.pdf');
const hasResume = existsSync(resumePath) && statSync(resumePath).isFile();
const base = import.meta.env.BASE_URL;
---

<Layout>
  <main id="main" class="container" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-intro">
        <p class="eyebrow"><span class="accent-mark" aria-hidden="true"></span>AI engineer / Dan Gilles</p>
        <h1 id="hero-title">I build tools for people working with <span>AI.</span></h1>
        <p class="hero-pitch">AI agents, developer tools, and forward-deployed engineering.</p>
        <p class="hero-description">I work directly with the people who use the software, turning ambiguous problems into working products and reliable agent workflows.</p>
        <div class="hero-actions">
          <a class="button primary" href="mailto:dangilles@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="https://github.com/Audacity88">GitHub <span aria-hidden="true">↗</span></a>
          {hasResume && <a class="button secondary" href={`${base}resume.pdf`}>Resume <span class="sr-only">PDF</span><span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <aside class="hero-note" aria-label="Current work">
        <span class="note-marker" aria-hidden="true">↳</span>
        <p class="eyebrow">What I work on</p>
        <p>Agent infrastructure.<br />Software that holds up<br />when people use it.</p>
        <div class="focus-item"><span>Building</span><a href="https://github.com/EyrieCommander/eyrie">Eyrie <span aria-hidden="true">↗</span></a></div>
        <div class="focus-item"><span>Contributing</span><a href={openSource.url}>ZeroClaw <span aria-hidden="true">↗</span></a></div>
      </aside>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="eyebrow">01 / Selected work</p><h2 id="projects-title">Things I've built<br />and contributed to.</h2></div>
        <p class="section-intro">Agent tooling, full-stack applications, and iOS experiments. Demo and build verification is in progress.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <section id="open-source" class="section" aria-labelledby="opensource-title">
      <div class="section-heading">
        <div><p class="eyebrow">02 / Open source</p><h2 id="opensource-title">Inside the runtime.</h2></div>
        <p class="section-intro">I'm a code owner and core contributor to ZeroClaw, an open-source Rust agent runtime. These upstream pull requests are merged.</p>
      </div>
      <div class="contribution-layout">
        <aside class="contribution-note">
          <h3>Reliability at each step.</h3>
          <p>My work includes delivering steering messages during a running turn, recovering sessions, and making agent costs visible.</p>
          <a class="text-link" href={openSource.mergedList}>See all merged pull requests on GitHub <span aria-hidden="true">↗</span></a>
        </aside>
        <ul class="pr-list" aria-label="Selected merged ZeroClaw pull requests">
          {openSource.pullRequests.map((pr) => (
            <li>
              <a class="pr-card" href={pr.url}>
                <span class="pr-meta">{pr.area}<span>#{pr.number} · Merged</span></span>
                <h3>{pr.title}<span aria-hidden="true"> ↗</span></h3>
                <time datetime={pr.mergedAt}>{new Date(`${pr.mergedAt}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="experience" class="section" aria-labelledby="experience-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Experience</p><h2 id="experience-title">Engineering, research,<br />and teaching.</h2></div></div>
      <ol class="timeline">
        {experience.roles.map((job) => (
          <li>
            <p class="timeline-period">{job.period}</p>
            <div class="timeline-content">
              <h3>{job.role}</h3><p class="organization">{job.organization}</p>
              <p>{job.summary}</p>
              {job.highlights.length > 0 && <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
              {job.clients.map((client) => {
                const name = client.needsDanOk ? client.publicDescription : client.name;
                return name && !name.includes('[CLIENT:') ? <p class="client-description">{name}</p> : null;
              })}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section about-section" aria-labelledby="about-title">
      <div><p class="eyebrow">04 / About</p><h2 id="about-title">An unusual route<br />into engineering.</h2></div>
      <div class="about-copy">
        <p>I spent about a decade living and teaching in Beijing before studying computational social science at the University of Chicago. English is my native language, and I'm professionally fluent in Mandarin Chinese.</p>
        <p>Now I build full-stack software and agent infrastructure. Coding agents write much of my code. I specify the problem, review every change, test it live, and decide what ships.</p>
        <dl class="education-list">
          <div><dt>University of Chicago</dt><dd>M.A., Computational Social Science, NLP/ML · 2024</dd></div>
          <div><dt>St. John's College</dt><dd>M.A., Eastern Classics · 2022<br />B.A., Liberal Arts, Great Books · 2013</dd></div>
        </dl>
      </div>
    </section>

    <section id="contact" class="section contact-section" aria-labelledby="contact-title">
      <p class="eyebrow">05 / Contact</p>
      <h2 id="contact-title">Have a problem<br />worth working on?</h2>
      <p>Let's talk about AI agents, developer tools, or building software with your team.</p>
      <a class="contact-email" href="mailto:dangilles@gmail.com">dangilles@gmail.com <span aria-hidden="true">↗</span></a>
      <ul class="social-links" aria-label="Find Dan online">
        <li><a href="https://github.com/Audacity88">GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://www.linkedin.com/in/dfgilles">LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://x.com/jialaowai">X <span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </main>
</Layout>
