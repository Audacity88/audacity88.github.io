---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import { projects } from '../../data/content';

export const getStaticPaths = (() => projects.map((project) => ({
  params: { id: project.id },
  props: { project },
}))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${project.title} | Dan Gilles`} description={project.description}>
  <main id="main" class="container project-detail" tabindex="-1">
    <article aria-labelledby="project-title">
      <a class="text-link" href={`${base}#projects`}><span aria-hidden="true">← </span>All projects</a>
      <header class="project-detail-heading">
        <p class="eyebrow">Selected work / Case study</p>
        <h1 id="project-title">{project.title}</h1>
        <p class="project-detail-pitch">{project.oneLiner}</p>
        <ProjectStatus status={project.status} label={project.statusLabel} />
      </header>
      <div class="project-detail-body">
        <section aria-labelledby="overview-title">
          <h2 id="overview-title">Overview</h2>
          <p>{project.description}</p>
          <ul class="tech-list" aria-label={`${project.title} technologies`}>
            {project.tech.map((tech) => <li>{tech}</li>)}
          </ul>
        </section>
        <section aria-labelledby="problem-title">
          <h2 id="problem-title">The problem</h2>
          <p>{project.caseStudy.problem}</p>
        </section>
        <section aria-labelledby="contribution-title">
          <h2 id="contribution-title">My contribution</h2>
          <p>{project.caseStudy.built}</p>
        </section>
        <section aria-labelledby="architecture-title">
          <h2 id="architecture-title">How it's built</h2>
          <p>{project.caseStudy.architecture}</p>
          {project.caseStudy.diagram && <ArchitectureDiagram id={project.id} diagram={project.caseStudy.diagram} />}
        </section>
        <section class="verification-note" aria-labelledby="verification-title">
          <h2 id="verification-title">What's verified</h2>
          <p class="project-verification"><time datetime={project.verificationDate}>Eyrie's reported checks · {project.verificationDate}</time>{project.verification}</p>
          <p>{project.verificationNote}</p>
        </section>
        <section aria-labelledby="limitations-title">
          <h2 id="limitations-title">What remains unverified</h2>
          <p>{project.caseStudy.limitations}</p>
        </section>
        {project.images.length > 0 && <section id="captures" aria-labelledby="captures-title">
          <h2 id="captures-title">Captured screens</h2>
          <ProjectMedia project={project} />
        </section>}
        <section aria-labelledby="links-title">
          <h2 id="links-title">Links</h2>
          <div class="project-links">
            <a href={project.github}>View on GitHub <span aria-hidden="true">↗</span></a>
            {project.demo && <a href={project.demo}>{project.demoLabel ?? 'View demo'}{project.status === 'pending-verification' && <span class="demo-pending"> · pending</span>}<span aria-hidden="true"> ↗</span></a>}
          </div>
        </section>
      </div>
    </article>
  </main>
</Layout>
