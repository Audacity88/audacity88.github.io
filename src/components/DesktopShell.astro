---
// L4a+b: Living desktop shell — wallpaper, dock, status strip + window manager
// Enter via :desktop command; exit via Esc, :cv, or dock CV control
import DesktopWindow from './DesktopWindow.astro';
---

<div class="desktop-shell" id="desktop-shell" hidden data-desktop-active="false">
  <div class="desktop-wallpaper" id="desktop-wallpaper"></div>
  
  <div class="desktop-status" id="desktop-status">
    <div class="status-group">
      <span class="status-time" id="status-time"></span>
      <span class="status-separator">·</span>
      <span class="status-palette" id="status-palette"></span>
    </div>
    <div class="status-command" id="status-command"></div>
  </div>
  
  <div class="desktop-dock" id="desktop-dock">
    <button type="button" class="dock-icon" data-app="cv" aria-label="Return to CV">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span class="dock-label">CV</span>
    </button>
    
    <div class="dock-divider"></div>
    
    <button type="button" class="dock-icon" data-app="about" aria-label="Open About">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 16v-4M12 8h.01"/>
      </svg>
      <span class="dock-label">About</span>
      <span class="dock-pip" hidden></span>
    </button>
    
    <button type="button" class="dock-icon" data-app="work" aria-label="Open Work">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="2" y="7" width="20" height="14" rx="2"/>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
      </svg>
      <span class="dock-label">Work</span>
      <span class="dock-pip" hidden></span>
    </button>
    
    <button type="button" class="dock-icon" data-app="offers" aria-label="Open Offers">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
        <line x1="10" y1="9" x2="8" y2="9"/>
      </svg>
      <span class="dock-label">Offers</span>
      <span class="dock-pip" hidden></span>
    </button>
    
    <button type="button" class="dock-icon" data-app="resume" aria-label="Open Resume">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="12" y1="18" x2="12" y2="12"/>
        <line x1="9" y1="15" x2="15" y2="15"/>
      </svg>
      <span class="dock-label">Resume</span>
      <span class="dock-pip" hidden></span>
    </button>
    
    <button type="button" class="dock-icon" data-app="terminal" aria-label="Open Terminal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="4 17 10 11 4 5"/>
        <line x1="12" y1="19" x2="20" y2="19"/>
      </svg>
      <span class="dock-label">Terminal</span>
      <span class="dock-pip" hidden></span>
    </button>
    
    <button type="button" class="dock-icon" data-app="settings" aria-label="Open Settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M12 1v6m0 6v6m9.66-10.66-4.24 4.24M10.5 13.5l-4.24 4.24M23 12h-6m-6 0H1m20.66 9.66-4.24-4.24M10.5 10.5l-4.24-4.24"/>
      </svg>
      <span class="dock-label">Settings</span>
      <span class="dock-pip" hidden></span>
    </button>
  </div>
  
  <div class="desktop-windows" id="desktop-windows">
    <DesktopWindow id="about" title="About">
      <div class="window-about">
        <p class="eyebrow"><span class="accent-mark" aria-hidden="true"></span>AI engineer / Dan Gilles</p>
        <h2>I build AI agents and <span>developer tools.</span></h2>
        <p class="about-pitch">From an ambiguous brief to a working pilot.</p>
        <p class="about-description">I work directly with the people who use the software. I also build agent infrastructure and contribute as a code owner to ZeroClaw, an open-source Rust agent runtime.</p>
        <div class="about-links">
          <a href="mailto:dan@dangilles.dev" class="button primary">Get in touch <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Audacity88" target="_blank" rel="noreferrer" class="button secondary">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="work" title="Work">
      <div class="window-work">
        <h3>Selected Projects</h3>
        <p class="work-intro">Agent tooling, full-stack applications, and iOS experiments. Each project states what was checked and what remains unverified.</p>
        <div class="work-list" id="work-list">
          <p class="loading-message">Loading projects...</p>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="offers" title="Offers">
      <div class="window-offers" id="offers-content">
        <p class="loading-message">Loading offers...</p>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="resume" title="Resume">
      <div class="window-resume">
        <h3>Resume</h3>
        <p>View or download my complete resume.</p>
        <div class="resume-actions">
          <a href="/resume/" target="_blank" rel="noreferrer" class="button primary">View Resume <span aria-hidden="true">↗</span></a>
          <a href="/resume.pdf" target="_blank" rel="noreferrer" class="button secondary">Download PDF <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="terminal" title="Terminal">
      <div class="window-terminal">
        <div class="terminal-output">
          <div class="terminal-line"><span class="terminal-prompt">~</span> whoami</div>
          <div class="terminal-result">
            <div class="terminal-row"><span class="terminal-label">user</span><span>Dan Gilles</span></div>
            <div class="terminal-row"><span class="terminal-label">role</span><span>AI engineer</span></div>
            <div class="terminal-row"><span class="terminal-label">building</span><span><a href="https://github.com/EyrieCommander/eyrie" target="_blank">Eyrie</a></span></div>
            <div class="terminal-row"><span class="terminal-label">contributing</span><span><a href="https://github.com/ZeroClaw/zeroclaw" target="_blank">ZeroClaw</a></span></div>
          </div>
          <div class="terminal-line"><span class="terminal-prompt">~</span> <span class="terminal-cursor">_</span></div>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="settings" title="Settings">
      <div class="window-settings">
        <h3>Appearance</h3>
        <p class="settings-description">Choose your preferred color palette.</p>
        
        <div class="settings-section">
          <h4>Wallpaper</h4>
          <div class="wallpaper-grid" id="wallpaper-grid">
            <button type="button" class="wallpaper-card" data-wallpaper="gradient">
              <div class="wallpaper-preview wallpaper-preview-gradient"></div>
              <span class="wallpaper-name">Gradient</span>
            </button>
            <button type="button" class="wallpaper-card" data-wallpaper="mountain">
              <div class="wallpaper-preview wallpaper-preview-mountain"></div>
              <span class="wallpaper-name">Mountain</span>
            </button>
            <button type="button" class="wallpaper-card" data-wallpaper="ocean">
              <div class="wallpaper-preview wallpaper-preview-ocean"></div>
              <span class="wallpaper-name">Ocean</span>
            </button>
            <button type="button" class="wallpaper-card" data-wallpaper="desert">
              <div class="wallpaper-preview wallpaper-preview-desert"></div>
              <span class="wallpaper-name">Desert</span>
            </button>
            <button type="button" class="wallpaper-card" data-wallpaper="night">
              <div class="wallpaper-preview wallpaper-preview-night"></div>
              <span class="wallpaper-name">Night</span>
            </button>
            <button type="button" class="wallpaper-card" data-wallpaper="minimal">
              <div class="wallpaper-preview wallpaper-preview-minimal"></div>
              <span class="wallpaper-name">Minimal</span>
            </button>
          </div>
        </div>
        
        <div class="settings-section">
          <h4>Color Palette</h4>
          <div class="palette-grid" id="palette-grid">
          <button type="button" class="palette-card" data-palette="system">
            <div class="palette-preview palette-preview-system"></div>
            <div class="palette-info">
              <span class="palette-card-name">Auto</span>
              <span class="palette-card-desc">System preference</span>
            </div>
          </button>
          <button type="button" class="palette-card" data-palette="light">
            <div class="palette-preview palette-preview-light"></div>
            <div class="palette-info">
              <span class="palette-card-name">Day</span>
              <span class="palette-card-desc">Light neutral</span>
            </div>
          </button>
          <button type="button" class="palette-card" data-palette="dark">
            <div class="palette-preview palette-preview-dark"></div>
            <div class="palette-info">
              <span class="palette-card-name">Night</span>
              <span class="palette-card-desc">Dark neutral</span>
            </div>
          </button>
          <button type="button" class="palette-card" data-palette="mono">
            <div class="palette-preview palette-preview-mono"></div>
            <div class="palette-info">
              <span class="palette-card-name">Mono</span>
              <span class="palette-card-desc">High contrast</span>
            </div>
          </button>
          <button type="button" class="palette-card" data-palette="ocean">
            <div class="palette-preview palette-preview-ocean"></div>
            <div class="palette-info">
              <span class="palette-card-name">Ocean</span>
              <span class="palette-card-desc">Blue depths</span>
            </div>
          </button>
        </div>
        </div>
        
        <div class="settings-section">
          <h4>Desktop Sharing</h4>
          <p class="settings-description">Copy a link to share your customized desktop layout.</p>
          <button type="button" id="copy-desktop-link" class="button primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            Copy Desktop Link
          </button>
          <div id="copy-feedback" class="copy-feedback" hidden></div>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-eyrie" title="Eyrie">
      <div class="window-project">
        <div class="project-stub">
          <div class="project-stub-icon">E</div>
          <h3>Eyrie</h3>
          <p class="project-oneliner">A local control room for AI agents.</p>
          <p class="project-description">Coordinate agents across ZeroClaw, OpenClaw, Hermes, PicoClaw, and Codex. A Go backend connects to a React dashboard over SSE and WebSockets.</p>
          <div class="project-links">
            <a href="https://github.com/EyrieCommander/eyrie" target="_blank" rel="noreferrer" class="button secondary">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <p class="project-note">Local only. No public demo available.</p>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-swift-ship" title="swift-ship">
      <div class="window-project">
        <iframe src="https://swift-ship-pi.vercel.app" class="project-iframe" title="swift-ship demo"></iframe>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-witness-lexington" title="Witness Lexington">
      <div class="window-project">
        <div class="project-simulacrum witness-lexington-sim">
          <div class="sim-viewport">
            <div class="sim-3d-scene"></div>
            <div class="sim-overlay">
              <h2 class="sim-title">Witness Lexington</h2>
              <p class="sim-subtitle">April 19, 1775</p>
              <div class="sim-controls">
                <button type="button" class="sim-button sim-button-primary" disabled>Begin the opening</button>
                <button type="button" class="sim-button" disabled>Mute music</button>
              </div>
            </div>
          </div>
          <div class="project-links">
            <a href="https://github.com/Audacity88/witness-lexington" target="_blank" rel="noreferrer" class="button secondary">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <p class="project-note">Interactive simulacrum. Real game requires local build.</p>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-model-picker" title="Model Picker">
      <div class="window-project">
        <div class="project-simulacrum model-picker-sim">
          <div class="sim-header">
            <span class="sim-logo">MP</span>
            <span class="sim-version">v1.0</span>
          </div>
          <div class="sim-content">
            <p class="sim-prompt">I want to <input type="text" value="build a feature from my spec" class="sim-input" readonly />, using <select class="sim-select" disabled><option>anything</option></select>, and my priority is <select class="sim-select" disabled><option>balanced</option></select>.</p>
            <button type="button" class="sim-button sim-button-primary" disabled>Pick a model</button>
            <div class="sim-results">
              <div class="sim-card">
                <div class="sim-card-header">
                  <span class="sim-rank">#1</span>
                  <span class="sim-model-name">claude-opus-4</span>
                  <span class="sim-score">92</span>
                </div>
                <p class="sim-reasoning">Strong reasoning, balanced cost/quality</p>
              </div>
              <div class="sim-card">
                <div class="sim-card-header">
                  <span class="sim-rank">#2</span>
                  <span class="sim-model-name">gpt-5-preview</span>
                  <span class="sim-score">88</span>
                </div>
                <p class="sim-reasoning">Excellent code generation, higher cost</p>
              </div>
              <div class="sim-card">
                <div class="sim-card-header">
                  <span class="sim-rank">#3</span>
                  <span class="sim-model-name">gemini-pro</span>
                  <span class="sim-score">85</span>
                </div>
                <p class="sim-reasoning">Good balance, large context window</p>
              </div>
            </div>
          </div>
          <p class="project-note">Interactive simulacrum. Real app runs locally.</p>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-codex-video-vision" title="codex-video-vision">
      <div class="window-project">
        <div class="project-stub">
          <div class="project-stub-icon">CV</div>
          <h3>codex-video-vision</h3>
          <p class="project-oneliner">Video tools for Codex. A credited port of an MIT-licensed project.</p>
          <div class="test-results">
            <div class="test-badge test-passed">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              108 tests passed
            </div>
          </div>
          <p class="project-description">A Codex video tool server using MCP, TypeScript, and ffmpeg. Provides timestamped frames and audio information for video inspection.</p>
          <div class="project-links">
            <a href="https://github.com/EyrieCommander/codex-video-vision" target="_blank" rel="noreferrer" class="button secondary">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-codex-skills" title="codex-skills">
      <div class="window-project">
        <div class="project-stub">
          <div class="project-stub-icon">CS</div>
          <h3>codex-skills</h3>
          <p class="project-oneliner">Reusable workflows for Codex.</p>
          <div class="skills-list">
            <div class="skill-item"><span class="skill-bullet">▸</span> Source intake & analysis</div>
            <div class="skill-item"><span class="skill-bullet">▸</span> Writing & documentation</div>
            <div class="skill-item"><span class="skill-bullet">▸</span> Media review workflows</div>
            <div class="skill-item"><span class="skill-bullet">▸</span> Maintenance automation</div>
            <div class="skill-item"><span class="skill-bullet">▸</span> Task history recovery</div>
            <div class="skill-item"><span class="skill-bullet">▸</span> Workspace path resolution</div>
          </div>
          <p class="project-description">A collection of Codex skills written in Python and Markdown, with an installer and recovery toolkit.</p>
          <div class="project-links">
            <a href="https://github.com/EyrieCommander/codex-skills" target="_blank" rel="noreferrer" class="button secondary">View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </DesktopWindow>
    
    <DesktopWindow id="project-chatgenius" title="ChatGenius">
      <div class="window-project">
        <div class="project-simulacrum chatgenius-sim">
          <div class="chat-sidebar">
            <div class="chat-workspace">Workspace</div>
            <div class="chat-channels">
              <div class="chat-section-header">Channels</div>
              <div class="chat-channel active"># general</div>
              <div class="chat-channel"># random</div>
              <div class="chat-channel"># support</div>
            </div>
            <div class="chat-dms">
              <div class="chat-section-header">Direct Messages</div>
              <div class="chat-dm"><span class="presence-dot"></span> Alice</div>
              <div class="chat-dm"><span class="presence-dot offline"></span> Bob</div>
            </div>
          </div>
          <div class="chat-main">
            <div class="chat-header"># general</div>
            <div class="chat-messages">
              <div class="chat-message">
                <div class="chat-avatar">A</div>
                <div class="chat-content">
                  <div class="chat-meta"><span class="chat-author">Alice</span> <span class="chat-time">10:23 AM</span></div>
                  <div class="chat-text">Hey team! Has anyone tried the new AI reply feature?</div>
                </div>
              </div>
              <div class="chat-message">
                <div class="chat-avatar">B</div>
                <div class="chat-content">
                  <div class="chat-meta"><span class="chat-author">Bot</span> <span class="chat-badge">AI</span> <span class="chat-time">10:23 AM</span></div>
                  <div class="chat-text">The AI reply feature uses message history and context to generate responses. Would you like me to demonstrate?</div>
                </div>
              </div>
              <div class="chat-message">
                <div class="chat-avatar">A</div>
                <div class="chat-content">
                  <div class="chat-meta"><span class="chat-author">Alice</span> <span class="chat-time">10:24 AM</span></div>
                  <div class="chat-text">That's helpful, thanks!</div>
                </div>
              </div>
            </div>
            <div class="chat-input-wrapper">
              <input type="text" class="chat-input" placeholder="Message #general" readonly />
            </div>
          </div>
          <p class="project-note">Interactive simulacrum. Code only, no live demo.</p>
        </div>
      </div>
    </DesktopWindow>
  </div>
</div>

<script>
  type DesktopMode = 'off' | 'on';
  type WindowState = {
    id: string;
    element: HTMLElement;
    isOpen: boolean;
    isMinimized: boolean;
    isMaximized: boolean;
    x: number;
    y: number;
    width: number;
    height: number;
  };
  
  const shell = document.getElementById('desktop-shell');
  const statusTime = document.getElementById('status-time');
  const statusPalette = document.getElementById('status-palette');
  const statusCommand = document.getElementById('status-command');
  const dockIcons = document.querySelectorAll<HTMLButtonElement>('.dock-icon');
  
  let lastScrollPosition = 0;
  let timeUpdateInterval: number | null = null;
  let highestZIndex = 1;
  let dragState: { window: HTMLElement; startX: number; startY: number; offsetX: number; offsetY: number } | null = null;
  
  const windows = new Map<string, WindowState>();
  const appIds = ['about', 'work', 'offers', 'resume', 'terminal', 'settings'];
  const projectIds = ['project-eyrie', 'project-swift-ship', 'project-witness-lexington', 'project-model-picker', 'project-codex-video-vision', 'project-codex-skills', 'project-chatgenius'];
  const allWindowIds = [...appIds, ...projectIds];
  
  const paletteDisplayNames: Record<string, string> = {
    light: 'Day',
    dark: 'Night',
    mono: 'Mono',
    ocean: 'Ocean',
  };
  
  type Wallpaper = 'gradient' | 'mountain' | 'ocean' | 'desert' | 'night' | 'minimal';
  let currentWallpaper: Wallpaper = 'gradient';
  
  // Check if we should skip desktop mode (deep links, ?still, reduced motion)
  function shouldSkipDesktop(): boolean {
    const url = new URL(window.location.href);
    const pathname = url.pathname;
    
    // Deep links should never force desktop
    if (pathname.includes('/resume') || pathname.includes('/offers') || pathname.includes('/projects/')) {
      return true;
    }
    
    // ?still or reduced motion preference
    if (url.searchParams.has('still') || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return true;
    }
    
    // Hash anchors (except #desktop)
    if (url.hash && url.hash !== '#desktop') {
      return true;
    }
    
    return false;
  }
  
  // Check if desktop mode is requested via URL
  function isDesktopRequested(): boolean {
    const url = new URL(window.location.href);
    return url.searchParams.has('desktop') || url.hash === '#desktop' || url.hash.startsWith('#desktop=');
  }
  
  // Extract shared desktop state from URL
  function extractSharedState(): any | null {
    const url = new URL(window.location.href);
    const hash = url.hash;
    
    if (hash.startsWith('#desktop=')) {
      const encoded = hash.substring('#desktop='.length);
      return decodeDesktopState(encoded);
    }
    
    return null;
  }
  
  // Update URL to reflect desktop mode
  function updateURL(mode: DesktopMode) {
    const url = new URL(window.location.href);
    
    if (mode === 'on') {
      // Add #desktop to preserve mode on reload
      url.hash = 'desktop';
    } else {
      // Remove desktop marker
      if (url.hash === '#desktop') {
        url.hash = '';
      }
      url.searchParams.delete('desktop');
    }
    
    // Replace state without triggering navigation
    window.history.replaceState({}, '', url.toString());
  }
  
  // Update status clock
  function updateClock() {
    if (!statusTime) return;
    
    const now = new Date();
    const hours = now.getHours().toString().padStart(2, '0');
    const minutes = now.getMinutes().toString().padStart(2, '0');
    statusTime.textContent = `${hours}:${minutes}`;
  }
  
  // Update status palette name
  function updatePaletteName() {
    if (!statusPalette) return;
    
    const currentPalette = document.documentElement.dataset.palette;
    const displayName = currentPalette ? paletteDisplayNames[currentPalette] || 'Auto' : 'Auto';
    statusPalette.textContent = displayName;
  }
  
  // Update last command in status
  function updateLastCommand(command: string) {
    if (!statusCommand) return;
    statusCommand.textContent = command ? `:${command}` : '';
  }
  
  // Enter desktop mode
  function enterDesktop() {
    if (!shell) return;
    if (shouldSkipDesktop()) return;
    
    // Save scroll position
    lastScrollPosition = window.scrollY;
    
    // Show desktop
    shell.removeAttribute('hidden');
    shell.dataset.desktopActive = 'true';
    document.body.style.overflow = 'hidden';
    
    // Update URL
    updateURL('on');
    
    // Start clock updates
    updateClock();
    updatePaletteName();
    if (timeUpdateInterval === null) {
      timeUpdateInterval = window.setInterval(updateClock, 1000);
    }
    
    // Announce to screen readers
    const announcement = document.createElement('div');
    announcement.setAttribute('role', 'status');
    announcement.setAttribute('aria-live', 'polite');
    announcement.className = 'sr-only';
    announcement.textContent = 'Desktop mode active. Press Escape or select CV to return.';
    document.body.appendChild(announcement);
    setTimeout(() => announcement.remove(), 1000);
  }
  
  // Exit desktop mode
  function exitDesktop() {
    if (!shell) return;
    
    // Hide desktop
    shell.setAttribute('hidden', '');
    shell.dataset.desktopActive = 'false';
    document.body.style.overflow = '';
    
    // Update URL
    updateURL('off');
    
    // Stop clock updates
    if (timeUpdateInterval !== null) {
      clearInterval(timeUpdateInterval);
      timeUpdateInterval = null;
    }
    
    // Restore scroll position
    window.scrollTo(0, lastScrollPosition);
    
    // Announce to screen readers
    const announcement = document.createElement('div');
    announcement.setAttribute('role', 'status');
    announcement.setAttribute('aria-live', 'polite');
    announcement.className = 'sr-only';
    announcement.textContent = 'Returned to CV';
    document.body.appendChild(announcement);
    setTimeout(() => announcement.remove(), 1000);
  }
  
  // Handle Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && shell?.dataset.desktopActive === 'true') {
      // Only handle escape if command palette is not open
      const commandPalette = document.getElementById('command-palette');
      if (commandPalette?.getAttribute('hidden') !== null) {
        e.preventDefault();
        
        // Check for focused window
        let focusedWindowId: string | null = null;
        let highestZ = 0;
        windows.forEach((state) => {
          if (state.isOpen && !state.isMinimized) {
            const z = parseInt(state.element.style.zIndex || '0');
            if (z > highestZ) {
              highestZ = z;
              focusedWindowId = state.id;
            }
          }
        });
        
        if (focusedWindowId) {
          closeWindow(focusedWindowId);
        } else {
          exitDesktop();
        }
      }
    }
  });
  
  // Apply wallpaper
  function applyWallpaper(wallpaper: Wallpaper) {
    const wallpaperEl = document.getElementById('desktop-wallpaper');
    if (!wallpaperEl) return;
    
    currentWallpaper = wallpaper;
    wallpaperEl.className = 'desktop-wallpaper';
    wallpaperEl.classList.add(`wallpaper-${wallpaper}`);
  }
  
  // Initialize windows
  function initWindows() {
    allWindowIds.forEach((id, index) => {
      const windowEl = document.getElementById(`window-${id}`);
      if (!windowEl) return;
      
      const isMobile = window.matchMedia('(max-width: 760px)').matches;
      const baseX = isMobile ? 0 : 100 + (index * 40);
      const baseY = isMobile ? 0 : 80 + (index * 40);
      
      windows.set(id, {
        id,
        element: windowEl,
        isOpen: false,
        isMinimized: false,
        isMaximized: false,
        x: baseX,
        y: baseY,
        width: 600,
        height: 500,
      });
      
      setupWindowControls(windowEl, id);
      setupWindowDrag(windowEl);
    });
  }
  
  // Open or focus a window
  function openWindow(id: string) {
    const state = windows.get(id);
    if (!state) return;
    
    if (state.isOpen && !state.isMinimized) {
      focusWindow(id);
      return;
    }
    
    state.isOpen = true;
    state.isMinimized = false;
    state.element.removeAttribute('hidden');
    state.element.dataset.minimized = 'false';
    
    const isMobile = window.matchMedia('(max-width: 760px)').matches;
    if (!isMobile) {
      state.element.style.left = `${state.x}px`;
      state.element.style.top = `${state.y}px`;
      state.element.style.width = `${state.width}px`;
      state.element.style.height = `${state.height}px`;
    }
    
    focusWindow(id);
    updateDockPip(id, true);
    loadWindowContent(id);
  }
  
  // Close a window
  function closeWindow(id: string) {
    const state = windows.get(id);
    if (!state) return;
    
    state.isOpen = false;
    state.element.setAttribute('hidden', '');
    updateDockPip(id, false);
  }
  
  // Minimize a window
  function minimizeWindow(id: string) {
    const state = windows.get(id);
    if (!state) return;
    
    state.isMinimized = true;
    state.element.dataset.minimized = 'true';
  }
  
  // Restore a minimized window
  function restoreWindow(id: string) {
    const state = windows.get(id);
    if (!state) return;
    
    if (state.isMinimized) {
      state.isMinimized = false;
      state.element.dataset.minimized = 'false';
      focusWindow(id);
    }
  }
  
  // Focus a window
  function focusWindow(id: string) {
    const state = windows.get(id);
    if (!state) return;
    
    highestZIndex++;
    state.element.style.zIndex = String(highestZIndex);
    
    windows.forEach((s) => {
      if (s.id !== id) {
        s.element.style.opacity = '0.95';
      } else {
        s.element.style.opacity = '1';
      }
    });
  }
  
  // Update dock pip indicator
  function updateDockPip(id: string, show: boolean) {
    const icon = document.querySelector(`.dock-icon[data-app="${id}"]`);
    const pip = icon?.querySelector('.dock-pip');
    if (pip) {
      if (show) {
        pip.removeAttribute('hidden');
      } else {
        pip.setAttribute('hidden', '');
      }
    }
  }
  
  // Setup window controls
  function setupWindowControls(windowEl: HTMLElement, id: string) {
    const closeBtn = windowEl.querySelector('.window-close');
    const minimizeBtn = windowEl.querySelector('.window-minimize');
    const maximizeBtn = windowEl.querySelector('.window-maximize');
    
    closeBtn?.addEventListener('click', () => closeWindow(id));
    minimizeBtn?.addEventListener('click', () => minimizeWindow(id));
    maximizeBtn?.addEventListener('click', () => {
      // Simple maximize toggle for now
      const state = windows.get(id);
      if (!state) return;
      
      if (!state.isMaximized) {
        state.isMaximized = true;
        windowEl.style.left = '10px';
        windowEl.style.top = '60px';
        windowEl.style.width = 'calc(100vw - 20px)';
        windowEl.style.height = 'calc(100vh - 140px)';
      } else {
        state.isMaximized = false;
        windowEl.style.left = `${state.x}px`;
        windowEl.style.top = `${state.y}px`;
        windowEl.style.width = `${state.width}px`;
        windowEl.style.height = `${state.height}px`;
      }
    });
    
    windowEl.addEventListener('mousedown', () => focusWindow(id));
  }
  
  // Setup window dragging
  function setupWindowDrag(windowEl: HTMLElement) {
    const titlebar = windowEl.querySelector('.window-titlebar') as HTMLElement;
    if (!titlebar) return;
    
    const isMobile = window.matchMedia('(max-width: 760px)').matches;
    if (isMobile) return;
    
    titlebar.addEventListener('mousedown', (e) => {
      const rect = windowEl.getBoundingClientRect();
      dragState = {
        window: windowEl,
        startX: e.clientX,
        startY: e.clientY,
        offsetX: e.clientX - rect.left,
        offsetY: e.clientY - rect.top,
      };
      
      windowEl.style.cursor = 'grabbing';
      e.preventDefault();
    });
  }
  
  // Handle mouse move for dragging
  document.addEventListener('mousemove', (e) => {
    if (!dragState) return;
    
    const x = e.clientX - dragState.offsetX;
    const y = e.clientY - dragState.offsetY;
    
    const maxX = window.innerWidth - 320;
    const maxY = window.innerHeight - 100;
    
    const clampedX = Math.max(0, Math.min(x, maxX));
    const clampedY = Math.max(0, Math.min(y, maxY));
    
    dragState.window.style.left = `${clampedX}px`;
    dragState.window.style.top = `${clampedY}px`;
    
    const id = dragState.window.dataset.windowId;
    const state = id ? windows.get(id) : null;
    if (state) {
      state.x = clampedX;
      state.y = clampedY;
    }
  });
  
  // Handle mouse up to end drag
  document.addEventListener('mouseup', () => {
    if (dragState) {
      dragState.window.style.cursor = '';
      dragState = null;
    }
  });
  
  // Load window content dynamically
  function loadWindowContent(id: string) {
    if (id === 'work') {
      loadWorkProjects();
    } else if (id === 'offers') {
      loadOffersContent();
    } else if (id === 'settings') {
      setupSettingsPalette();
    }
  }
  
  async function loadWorkProjects() {
    const workList = document.getElementById('work-list');
    if (!workList || workList.dataset.loaded) return;
    
    const projects = [
      { id: 'project-eyrie', title: 'Eyrie', oneliner: 'A local control room for AI agents.' },
      { id: 'project-swift-ship', title: 'swift-ship', oneliner: 'An AI customer support desk.' },
      { id: 'project-witness-lexington', title: 'Witness Lexington', oneliner: 'A 3D history game set at Lexington, April 1775.' },
      { id: 'project-model-picker', title: 'Model Picker', oneliner: 'Recommends AI models for a task.' },
      { id: 'project-codex-video-vision', title: 'codex-video-vision', oneliner: 'Video tools for Codex.' },
      { id: 'project-codex-skills', title: 'codex-skills', oneliner: 'Reusable workflows for Codex.' },
      { id: 'project-chatgenius', title: 'ChatGenius', oneliner: 'Slack-like chat with AI replies.' },
    ];
    
    let html = '';
    projects.forEach((project) => {
      html += `<div class="work-card" data-project="${project.id}">
        <h4>${project.title}</h4>
        <p>${project.oneliner}</p>
        <button type="button" class="button-link open-project" data-project="${project.id}">Open →</button>
      </div>`;
    });
    
    workList.innerHTML = html;
    workList.dataset.loaded = 'true';
    
    workList.querySelectorAll('.open-project').forEach(btn => {
      btn.addEventListener('click', () => {
        const projectId = (btn as HTMLElement).dataset.project;
        if (projectId) {
          openWindow(projectId);
          updateLastCommand(projectId.replace('project-', ''));
        }
      });
    });
  }
  
  async function loadOffersContent() {
    const offersContent = document.getElementById('offers-content');
    if (!offersContent || offersContent.dataset.loaded) return;
    
    try {
      offersContent.innerHTML = '<h3>Offers</h3><p>View my current offers and availability.</p><a href="/offers/" target="_blank" class="button primary">View Full Offers Page <span aria-hidden="true">↗</span></a>';
      offersContent.dataset.loaded = 'true';
    } catch (e) {
      offersContent.innerHTML = '<p>Could not load offers.</p>';
    }
  }
  
  function setupSettingsPalette() {
    const paletteCards = document.querySelectorAll('#palette-grid .palette-card');
    const currentPalette = document.documentElement.dataset.palette || 'system';
    
    paletteCards.forEach((card) => {
      const palette = (card as HTMLElement).dataset.palette;
      if (palette === currentPalette) {
        card.setAttribute('aria-pressed', 'true');
      }
      
      card.addEventListener('click', () => {
        if (!palette) return;
        
        if (palette === 'system') {
          delete document.documentElement.dataset.palette;
          localStorage.removeItem('portfolio-palette');
        } else {
          document.documentElement.dataset.palette = palette;
          localStorage.setItem('portfolio-palette', palette);
        }
        
        paletteCards.forEach((c) => c.removeAttribute('aria-pressed'));
        card.setAttribute('aria-pressed', 'true');
        updatePaletteName();
        updateLastCommand('theme');
      });
    });
    
    const wallpaperCards = document.querySelectorAll('#wallpaper-grid .wallpaper-card');
    wallpaperCards.forEach((card) => {
      const wallpaper = (card as HTMLElement).dataset.wallpaper as Wallpaper;
      if (wallpaper === currentWallpaper) {
        card.setAttribute('aria-pressed', 'true');
      }
      
      card.addEventListener('click', () => {
        if (!wallpaper) return;
        
        applyWallpaper(wallpaper);
        wallpaperCards.forEach((c) => c.removeAttribute('aria-pressed'));
        card.setAttribute('aria-pressed', 'true');
        updateLastCommand('wallpaper');
      });
    });
    
    const copyLinkBtn = document.getElementById('copy-desktop-link');
    const copyFeedback = document.getElementById('copy-feedback');
    copyLinkBtn?.addEventListener('click', () => {
      const desktopState = captureDesktopState();
      const encoded = encodeDesktopState(desktopState);
      const url = new URL(window.location.href);
      url.hash = `desktop=${encoded}`;
      
      navigator.clipboard.writeText(url.toString()).then(() => {
        if (copyFeedback) {
          copyFeedback.textContent = 'Link copied!';
          copyFeedback.removeAttribute('hidden');
          setTimeout(() => {
            copyFeedback.setAttribute('hidden', '');
          }, 2000);
        }
        
        window.history.replaceState({}, '', url.toString());
      }).catch(() => {
        if (copyFeedback) {
          copyFeedback.textContent = 'Copy failed';
          copyFeedback.removeAttribute('hidden');
          setTimeout(() => {
            copyFeedback.setAttribute('hidden', '');
          }, 2000);
        }
      });
    });
  }
  
  function captureDesktopState() {
    const dockOrder = Array.from(dockIcons).map(icon => (icon as HTMLElement).dataset.app || '');
    const windowStates: Record<string, any> = {};
    
    windows.forEach((state, id) => {
      if (state.isOpen) {
        windowStates[id] = {
          x: state.x,
          y: state.y,
          width: state.width,
          height: state.height,
          isOpen: state.isOpen,
          isMinimized: state.isMinimized,
          isMaximized: state.isMaximized,
        };
      }
    });
    
    return {
      wallpaper: currentWallpaper,
      dockOrder,
      windows: windowStates,
    };
  }
  
  function encodeDesktopState(state: any): string {
    const compact = {
      w: state.wallpaper,
      d: state.dockOrder,
      o: Object.entries(state.windows).map(([id, win]: [string, any]) => ({
        i: id,
        x: Math.round(win.x),
        y: Math.round(win.y),
        w: Math.round(win.width),
        h: Math.round(win.height),
        m: win.isMinimized ? 1 : 0,
        M: win.isMaximized ? 1 : 0,
      })),
    };
    
    try {
      const json = JSON.stringify(compact);
      return btoa(json)
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=+$/, '');
    } catch {
      return '';
    }
  }
  
  function decodeDesktopState(encoded: string): any | null {
    if (!encoded) return null;
    
    try {
      const base64 = encoded
        .replace(/-/g, '+')
        .replace(/_/g, '/');
      const padded = base64 + '=='.substring(0, (4 - base64.length % 4) % 4);
      const json = atob(padded);
      const compact = JSON.parse(json);
      
      if (!compact.w || !Array.isArray(compact.d)) {
        return null;
      }
      
      const windowStates: Record<string, any> = {};
      if (Array.isArray(compact.o)) {
        compact.o.forEach((win: any) => {
          if (win.i && typeof win.x === 'number' && typeof win.y === 'number') {
            windowStates[win.i] = {
              x: win.x,
              y: win.y,
              width: win.w || 600,
              height: win.h || 500,
              isOpen: true,
              isMinimized: win.m === 1,
              isMaximized: win.M === 1,
            };
          }
        });
      }
      
      return {
        wallpaper: compact.w,
        dockOrder: compact.d,
        windows: windowStates,
      };
    } catch {
      return null;
    }
  }
  
  function applyDesktopState(state: any) {
    if (!state) return;
    
    if (state.wallpaper) {
      applyWallpaper(state.wallpaper);
    }
    
    if (state.windows) {
      Object.entries(state.windows).forEach(([id, winState]: [string, any]) => {
        const state = windows.get(id);
        if (state && winState.isOpen) {
          state.x = winState.x;
          state.y = winState.y;
          state.width = winState.width;
          state.height = winState.height;
          state.isMaximized = winState.isMaximized;
          openWindow(id);
          if (winState.isMinimized) {
            minimizeWindow(id);
          }
        }
      });
    }
  }
  
  // Handle dock icon clicks
  dockIcons.forEach((icon) => {
    icon.addEventListener('click', () => {
      const app = icon.dataset.app;
      
      if (app === 'cv') {
        exitDesktop();
        updateLastCommand('cv');
      } else if (app && appIds.includes(app)) {
        const state = windows.get(app);
        if (state?.isOpen && state.isMinimized) {
          restoreWindow(app);
        } else if (state?.isOpen) {
          focusWindow(app);
        } else {
          openWindow(app);
        }
        updateLastCommand(app);
      }
    });
  });
  
  // Listen for palette changes
  const observer = new MutationObserver(() => {
    updatePaletteName();
  });
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-palette'],
  });
  
  // Initialize windows
  initWindows();
  
  // Initialize on load
  if (isDesktopRequested() && !shouldSkipDesktop()) {
    const sharedState = extractSharedState();
    
    // Wait for page to settle before entering
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        enterDesktop();
        
        if (sharedState) {
          setTimeout(() => {
            applyDesktopState(sharedState);
          }, 100);
        }
      });
    });
  }
  
  // Export functions for CommandPalette integration
  (window as any).portfolioDesktop = {
    enter: enterDesktop,
    exit: exitDesktop,
    updateCommand: updateLastCommand,
  };
</script>

