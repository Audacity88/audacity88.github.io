---
// Desktop mode toggle control
---

<div class="desktop-toggle-control">
  <button type="button" class="desktop-toggle" id="desktop-toggle" hidden>
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
      <rect x="2" y="4" width="16" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      <path d="M6 15v2M14 15v2M4 17h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <span id="desktop-toggle-label">Desktop</span>
  </button>
</div>

<script>
  function init() {
    const button = document.querySelector<HTMLButtonElement>('#desktop-toggle');
    
    if (!button) return;
    
    function toggleDesktop() {
      const desktop = (window as any).portfolioDesktop;
      if (!desktop) return;
      
      const shell = document.getElementById('desktop-shell');
      const isActive = shell?.dataset.desktopActive === 'true';
      
      if (isActive) {
        desktop.exit();
        desktop.updateCommand('cv');
      } else {
        desktop.enter();
        desktop.updateCommand('desktop');
      }
    }
    
    button.hidden = false;
    button.setAttribute('aria-label', 'Toggle desktop mode');
    
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDesktop();
    });
    
    // Update button state when desktop mode changes
    const observer = new MutationObserver(() => {
      const shell = document.getElementById('desktop-shell');
      const isActive = shell?.dataset.desktopActive === 'true';
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    
    const shell = document.getElementById('desktop-shell');
    if (shell) {
      observer.observe(shell, { attributes: true, attributeFilter: ['data-desktop-active'] });
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .desktop-toggle-control {
    position: relative;
    flex: 0 0 98px;
    width: 98px;
    height: 44px;
  }
  
  .desktop-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 0.45rem 0.75rem;
    height: 44px;
    width: 98px;
    font-family: var(--mono);
    font-size: 0.68rem;
    white-space: nowrap;
    border-radius: 999px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }
  
  .desktop-toggle:is(:hover, :focus-visible) {
    color: var(--accent-text);
    border-color: var(--accent);
  }
  
  .desktop-toggle[aria-pressed='true'] {
    background: var(--tint);
    color: var(--accent-text);
    border-color: var(--accent);
  }
  
  @media (max-width: 760px) {
    .desktop-toggle-control {
      flex: 0 0 44px;
      width: 44px;
    }
    
    .desktop-toggle {
      width: 44px;
      padding: 0.45rem 0.5rem;
    }
    
    .desktop-toggle span {
      display: none;
    }
  }
</style>
