---
import type { Project } from '../data/content';
import ProjectStatus from './ProjectStatus.astro';

interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class:list={['project-card', { featured: project.featured }]} data-project={project.id} aria-labelledby={`project-${project.id}`}>
  <div class="card-topline">
    <span class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <ProjectStatus status={project.status} />
  </div>
  {project.id === 'zeroclaw' && <div class="runtime-art" aria-hidden="true"><span>ZeroClaw</span><svg viewBox="0 0 300 120" fill="none" focusable="false"><path d="M0 85H62L82 30L110 104L138 12L166 85H300" /><path class="runtime-baseline" d="M0 85H300" /></svg><span class="runtime-art-label">Abstract illustration · Rust agent runtime</span></div>}
  {project.images && (project.images.length > 0 ? (
    <div class="project-media">
      {project.images.map((image) => <img src={`${base}${image.src}`} alt={image.alt} loading="lazy" width="720" height="400" />)}
    </div>
  ) : (
    <div class:list={['media-placeholder', { 'eyrie-placeholder': project.id === 'eyrie' }]}>
      {project.id === 'eyrie' ? (
        <svg viewBox="0 0 440 130" aria-hidden="true" focusable="false" fill="none">
          <path d="M58 65H382M220 25V105M100 25L340 105M100 105L340 25" />
          <circle cx="220" cy="65" r="27" class="diagram-halo" />
          <circle cx="220" cy="65" r="9" class="diagram-core" />
          <circle cx="58" cy="65" r="5" /><circle cx="382" cy="65" r="5" />
          <circle cx="100" cy="25" r="5" /><circle cx="100" cy="105" r="5" />
          <circle cx="340" cy="25" r="5" /><circle cx="340" cy="105" r="5" />
          <circle cx="220" cy="25" r="4" /><circle cx="220" cy="105" r="4" />
        </svg>
      ) : <span class="media-initial" aria-hidden="true">{project.id === 'tono4' ? '字' : '▶'}</span>}
      <span class="placeholder-label">{project.id === 'eyrie' ? 'Abstract illustration · Screenshots pending' : 'iOS · Video & screenshots pending'}</span>
      <!-- TODO: Replace the empty media slot with genuine approved project captures. -->
    </div>
  ))}
  <h3 id={`project-${project.id}`}><a class="project-title-link" href={`${base}/projects/${project.id}/`}>{project.title}</a></h3>
  <p class="project-oneliner">{project.oneLiner}</p>
  <p class="project-description">{project.description}</p>
  <ul class="tech-list" aria-label={`${project.title} technologies`}>
    {project.tech.map((tech) => <li>{tech}</li>)}
  </ul>
  <div class="project-links">
    <a href={`${base}/projects/${project.id}/`}>Project details<span aria-hidden="true"> →</span><span class="sr-only"> for {project.title}</span></a>
    <a href={project.github}>{project.id === 'zeroclaw' ? 'Merged pull requests' : 'View on GitHub'}<span aria-hidden="true"> ↗</span><span class="sr-only"> for {project.title}</span></a>
    {project.demo && <a href={project.demo}>View demo{project.status === 'pending-verification' && <span class="demo-pending"> · pending</span>}<span aria-hidden="true"> ↗</span><span class="sr-only"> for {project.title}</span></a>}
  </div>
</article>
