---
import type { Project } from '../data/content';
import ProjectStatus from './ProjectStatus.astro';
import ProjectMedia from './ProjectMedia.astro';
import ProjectLinks from './ProjectLinks.astro';

interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const assetBase = base.replace(/\/$/, '');
const thumb = !project.featured ? project.images[0] : undefined;
---

<article class:list={['project-card', { featured: project.featured }]} data-project={project.id} aria-labelledby={`project-${project.id}`}>
  <div class="card-topline">
    <span class="project-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <ProjectStatus status={project.status} label={project.statusLabel} />
  </div>
  {thumb && <a class="project-card-thumb" href={`${base}projects/${project.id}/#captures`} tabindex="-1" aria-hidden="true">
    <img src={`${assetBase}${thumb.src}`} srcset={thumb.sources.map((source) => `${assetBase}${source.src} ${source.width}w`).join(', ')}
      sizes="auto, (max-width: 760px) calc(100vw - 5rem), 560px" alt="" width={thumb.width} height={thumb.height} loading="lazy" decoding="async" />
  </a>}
  <div class="project-card-content">
    <h3 id={`project-${project.id}`}><a class="project-title-link" href={`${base}projects/${project.id}/`}>{project.title}</a></h3>
    <p class="project-oneliner">{project.oneLiner}</p>
    <p class="project-description">{project.description}</p>
    <ul class="tech-list" aria-label={`${project.title} technologies`}>
      {project.tech.map((tech) => <li>{tech}</li>)}
    </ul>
    <p class="project-verification"><time datetime={project.verificationDate}>Checked {project.verificationDate}</time>{project.verification}</p>
    <ProjectLinks project={project} showDetails />
  </div>
  {project.featured && project.images.length > 0 && <div class="project-card-media"><ProjectMedia project={project} preview /><a class="text-link" href={`${base}projects/${project.id}/#captures`}>See all first-run captures <span aria-hidden="true">→</span></a></div>}
</article>
