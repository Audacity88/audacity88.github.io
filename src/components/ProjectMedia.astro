---
import type { Project } from '../data/content';
import ProjectDemo from './ProjectDemo.astro';

interface Props { project: Project; preview?: boolean }
const { project, preview = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const images = preview ? project.images.slice(0, 1) : project.images;
const hasInteractiveDemo = preview && project.inCardDemo;
// Match the container, card padding, and stacked flagship breakpoints in global.css.
// Lazy images use their measured width where sizes="auto" is supported.
const sizes = preview
  ? 'auto, (max-width: 360px) calc(100vw - 4.3rem - 2px), (max-width: 760px) calc(100vw - 5.5rem - 2px), (max-width: 960px) calc(100vw - 8rem - 2px), (max-width: 1050px) calc(55vw - 5.775rem - 1.1px), (max-width: 1296px) calc(55vw - 6.875rem - 1.1px), 602px'
  : 'auto, (max-width: 360px) calc(100vw - 2rem), (max-width: 760px) calc(100vw - 2.5rem), (max-width: 864px) calc(100vw - 4rem), 800px';
---

<div class:list={['project-media', { 'has-interactive-demo': hasInteractiveDemo }]} data-project-id={hasInteractiveDemo ? project.id : undefined}>
  {hasInteractiveDemo && (
    <div class="interactive-demo-container" data-state="idle">
      <div class="demo-static-preview">
        {images.map((image) => (
          <figure>
            <img src={`${base}${image.src}`} srcset={image.sources.map((source) => `${base}${source.src} ${source.width}w`).join(', ')}
              sizes={sizes}
              alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
        <button type="button" class="demo-activate-button" aria-label={`Activate ${project.title} demo`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span>Run Demo</span>
        </button>
      </div>
      <div class="demo-interactive-view" hidden>
        <div class="demo-frame">
          <ProjectDemo project={project} />
        </div>
        <button type="button" class="demo-close-button" aria-label="Close demo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Close</span>
        </button>
      </div>
    </div>
  )}
  
  {!hasInteractiveDemo && images.map((image) => (
    <figure>
      <a href={`${base}${image.src}`} aria-label={`View full-size capture: ${image.caption}`}>
        <img src={`${base}${image.src}`} srcset={image.sources.map((source) => `${base}${source.src} ${source.width}w`).join(', ')}
          sizes={sizes}
          alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
      </a>
      <figcaption>{image.caption}</figcaption>
    </figure>
  ))}
</div>

{hasInteractiveDemo && (
  <script>
    function initInteractiveDemo() {
      const containers = document.querySelectorAll('.interactive-demo-container');
      
      containers.forEach((container) => {
        const activateBtn = container.querySelector('.demo-activate-button');
        const closeBtn = container.querySelector('.demo-close-button');
        const staticPreview = container.querySelector('.demo-static-preview');
        const interactiveView = container.querySelector('.demo-interactive-view');
        
        if (!activateBtn || !closeBtn || !staticPreview || !interactiveView) return;
        
        activateBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          container.setAttribute('data-state', 'active');
          staticPreview.setAttribute('hidden', '');
          interactiveView.removeAttribute('hidden');
          
          const announcement = document.createElement('div');
          announcement.setAttribute('role', 'status');
          announcement.setAttribute('aria-live', 'polite');
          announcement.className = 'sr-only';
          announcement.textContent = 'Demo activated';
          document.body.appendChild(announcement);
          setTimeout(() => announcement.remove(), 1000);
        });
        
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          container.setAttribute('data-state', 'idle');
          interactiveView.setAttribute('hidden', '');
          staticPreview.removeAttribute('hidden');
          
          const announcement = document.createElement('div');
          announcement.setAttribute('role', 'status');
          announcement.setAttribute('aria-live', 'polite');
          announcement.className = 'sr-only';
          announcement.textContent = 'Demo closed';
          document.body.appendChild(announcement);
          setTimeout(() => announcement.remove(), 1000);
        });
      });
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInteractiveDemo);
    } else {
      initInteractiveDemo();
    }
  </script>
)}

<style>
  .project-media.has-interactive-demo {
    position: relative;
  }

  .interactive-demo-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 280px;
    background: var(--surface);
    border-radius: 8px;
    overflow: hidden;
  }

  .demo-static-preview {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .demo-static-preview figure {
    width: 100%;
    height: 100%;
    margin: 0;
    position: relative;
  }

  .demo-static-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .demo-static-preview figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    color: #f3f4f6;
    font-size: 0.75rem;
  }

  .demo-activate-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: white;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 200ms ease;
    opacity: 0;
  }

  .demo-static-preview:hover .demo-activate-button,
  .demo-activate-button:focus-visible {
    opacity: 1;
  }

  .demo-activate-button:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: translate(-50%, -50%) scale(1.05);
  }

  .demo-activate-button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .demo-activate-button svg {
    width: 18px;
    height: 18px;
  }

  .demo-interactive-view {
    position: absolute;
    inset: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }

  .demo-frame {
    flex: 1;
    overflow: hidden;
  }

  .demo-close-button {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: white;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 160ms ease;
    z-index: 10;
  }

  .demo-close-button:hover {
    background: #ef4444;
    border-color: #dc2626;
  }

  .demo-close-button:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .demo-close-button svg {
    width: 14px;
    height: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-activate-button {
      opacity: 1;
      transform: translate(-50%, -50%);
    }

    .demo-activate-button:hover {
      transform: translate(-50%, -50%);
    }
  }

  @media (max-width: 760px) {
    .interactive-demo-container {
      min-height: 240px;
    }

    .demo-activate-button {
      opacity: 1;
    }

    .demo-activate-button span {
      display: none;
    }

    .demo-close-button span {
      display: none;
    }
  }
</style>
