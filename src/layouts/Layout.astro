---
import '../styles/global.css';
import '../styles/print.css';
import PaletteMenu from '../components/PaletteMenu.astro';
import DesktopToggle from '../components/DesktopToggle.astro';
import CommandPalette from '../components/CommandPalette.astro';
import SectionStatus from '../components/SectionStatus.astro';
import DesktopShell from '../components/DesktopShell.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Dan Gilles | AI engineer',
  description = 'Dan Gilles builds AI agents, developer tools, and full-stack software directly with the people who use it. Selected projects and open-source contributions.',
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${base}og-card.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Dan Gilles" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dan Gilles. AI engineer. AI agents, developer tools, and forward-deployed engineering." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <meta name="twitter:image:alt" content="Dan Gilles. AI engineer. AI agents, developer tools, and forward-deployed engineering." />
    {!noindex && <link rel="canonical" href={canonical.toString()} />}
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <title>{title}</title>
    <style>
      /* Critical CSS: Hide ALL page chrome when SoftEnter gate is active to prevent FOUC */
      html.soft-enter-gate .site-header,
      html.soft-enter-gate .site-footer,
      html.soft-enter-gate main,
      html.soft-enter-gate .command-palette,
      html.soft-enter-gate .section-status,
      html.soft-enter-gate .desktop-shell {
        visibility: hidden;
      }
      /* Show SoftEnter only when gate is active (wins over scoped styles) */
      html.soft-enter-gate .soft-enter {
        display: flex !important;
      }
      /* Force hide if prefers-reduced-motion (CSS-level guard) */
      @media (prefers-reduced-motion: reduce) {
        html.soft-enter-gate .soft-enter {
          display: none !important;
        }
        html.soft-enter-gate .site-header,
        html.soft-enter-gate .site-footer,
        html.soft-enter-gate main,
        html.soft-enter-gate .command-palette,
        html.soft-enter-gate .section-status,
        html.soft-enter-gate .desktop-shell {
          visibility: visible !important;
        }
      }
    </style>
    <script is:inline>
      // Blocking inline gate: decide show vs skip BEFORE first paint
      (function() {
        var STORAGE_KEY = 'portfolio-enter-seen';
        
        function shouldShowEnter() {
          // Skip if prefers-reduced-motion
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return false;
          }
          
          // Skip if query params present
          var params = new URLSearchParams(window.location.search);
          if (params.has('still') || params.has('skip-enter')) {
            return false;
          }
          
          // Skip on deep links (non-home routes)
          var base = '{base}';
          var path = window.location.pathname;
          var normalizedPath = path.endsWith('/') ? path : path + '/';
          var normalizedBase = base.endsWith('/') ? base : base + '/';
          
          if (normalizedPath !== normalizedBase) {
            return false;
          }
          
          // Skip if already seen in this session
          try {
            if (sessionStorage.getItem(STORAGE_KEY)) {
              return false;
            }
          } catch (e) {
            // sessionStorage unavailable, show enter anyway
          }
          
          return true;
        }
        
        // Set gate class on HTML element (exists in head, before body paints)
        if (shouldShowEnter()) {
          document.documentElement.classList.add('soft-enter-gate');
        }
      })();
    </script>
    <script is:inline>
      try {
        let palette = localStorage.getItem('portfolio-palette');
        if (!palette) {
          // Migrate legacy portfolio-theme to portfolio-palette
          const legacyTheme = localStorage.getItem('portfolio-theme');
          if (legacyTheme === 'light' || legacyTheme === 'dark') {
            palette = legacyTheme;
            localStorage.setItem('portfolio-palette', palette);
            localStorage.removeItem('portfolio-theme');
          }
        }
        if (palette && ['light', 'dark', 'mono', 'ocean'].includes(palette)) {
          document.documentElement.dataset.palette = palette;
        }
      } catch { /* System preferences work when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href={base} aria-label="Dan Gilles, home">Dan Gilles<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href={`${base}#projects`} aria-current={Astro.url.pathname.startsWith(`${base}projects/`) ? 'location' : undefined}>Projects</a>
        <a href={`${base}#open-source`}>Open source</a>
        <a href={`${base}#experience`}>Experience</a>
        <a href={`${base}resume/`} aria-current={Astro.url.pathname === `${base}resume/` ? 'page' : undefined}>Resume</a>
        <a href={`${base}offers/`} aria-current={Astro.url.pathname === `${base}offers/` ? 'page' : undefined}>Offers</a>
        <a href={`${base}#contact`}>Contact</a>
      </nav>
      <DesktopToggle />
      <PaletteMenu />
    </header>
    <CommandPalette />
    <SectionStatus />
    <DesktopShell />
    <slot />
    <footer class="site-footer container">
      <a class="footer-name" href={base}>Dan Gilles<span aria-hidden="true">.</span></a>
      <span>Built with Astro. No tracking.</span>
      <a href={`${base}art/`}>Art</a>
      <span class="command-hint" id="command-hint">Press <kbd>:</kbd> for commands</span>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
    <script>
      import { onShellStateChange } from '../lib/portfolio-shell';
      
      function init() {
        const wordmark = document.querySelector('.wordmark');
        const navLinks = document.querySelectorAll('.site-header nav a');
        
        const sectionToNav: Record<string, string> = {
          'projects': 'projects',
          'open-source': 'open-source',
          'experience': 'experience',
          'how-i-work': 'how-i-work',
          'about': 'about',
          'contact': 'contact',
        };
        
        onShellStateChange((changes) => {
          if (changes.palette !== undefined && wordmark) {
            wordmark.classList.add('accent-flash');
            setTimeout(() => {
              wordmark.classList.remove('accent-flash');
            }, 400);
          }
          
          if (changes.activeSection !== undefined && changes.activeSection !== null) {
            const targetId = sectionToNav[changes.activeSection];
            navLinks.forEach((link) => {
              const href = (link as HTMLAnchorElement).getAttribute('href') || '';
              const hashMatch = href.match(/#([^?]+)/);
              const linkSectionId = hashMatch ? hashMatch[1] : null;
              
              if (linkSectionId === targetId) {
                link.setAttribute('aria-current', 'location');
              } else if (href.includes('#')) {
                link.removeAttribute('aria-current');
              }
            });
          }
        });
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>
  </body>
</html>
